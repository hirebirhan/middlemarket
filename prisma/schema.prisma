generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum RequestType {
  PRODUCT
  SERVICE
}

enum RequestStatus {
  OPEN
  MATCHED
  CLOSED
}

enum OfferStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  ACCEPTED
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String
  role      Role      @default(BUYER)
  createdAt DateTime  @default(now())
  requests  Request[]
  offers    Offer[]
}

model Request {
  id          String        @id @default(cuid())
  title       String
  description String
  type        RequestType
  budget      Decimal?      @db.Decimal(12, 2)
  status      RequestStatus @default(OPEN)
  buyer       User          @relation(fields: [buyerId], references: [id])
  buyerId     String
  offers      Offer[]
  createdAt   DateTime      @default(now())
}

model Offer {
  id            String      @id @default(cuid())
  price         Decimal     @db.Decimal(12, 2)
  adminPrice    Decimal?    @db.Decimal(12, 2)
  message       String
  status        OfferStatus @default(PENDING_REVIEW)
  adminNote     String?
  request       Request     @relation(fields: [requestId], references: [id])
  requestId     String
  seller        User        @relation(fields: [sellerId], references: [id])
  sellerId      String
  order         Order?
  createdAt     DateTime    @default(now())
}

model Order {
  id        String      @id @default(cuid())
  offer     Offer       @relation(fields: [offerId], references: [id])
  offerId   String      @unique
  status    OrderStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}
